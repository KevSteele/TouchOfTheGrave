# BigWigs packager configuration (https://github.com/BigWigsMods/packager).
# The repository holds the addon in the folder TouchOfTheGrave. The packager
# copies the repository into .release/TouchOfTheGrave, then moves the addon
# folder up one level, so the zip has TouchOfTheGrave/TouchOfTheGrave.toc.
package-as: TouchOfTheGrave

move-folders:
  TouchOfTheGrave/TouchOfTheGrave: TouchOfTheGrave

enable-nolib-creation: no

manual-changelog: CHANGELOG.md

ignore:
  - .github
  - docs
  - tools
  - README.md
  - CHANGELOG.md
  - LICENSE
  - .gitignore
  - .pkgmeta
